{
  "name": "@agnostic-cloud/pubsub",
  "version": "0.2.0",
  "description": "Unified pub/sub interface for AWS SNS/SQS, GCP Pub/Sub, and Azure Event Grid/Event Hubs/Service Bus",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@aws-sdk/client-sns": "^3.1095.0",
    "@aws-sdk/client-sqs": "^3.1095.0",
    "@azure/event-hubs": "^5.12.2",
    "@azure/eventgrid": "^4.15.0",
    "@azure/identity": "^4.13.1",
    "@azure/service-bus": "^7.9.5",
    "@google-cloud/pubsub": "^4.11.0",
    "oci-sdk": "^2.137.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-sns": {
      "optional": true
    },
    "@aws-sdk/client-sqs": {
      "optional": true
    },
    "@azure/event-hubs": {
      "optional": true
    },
    "@azure/eventgrid": {
      "optional": true
    },
    "@azure/identity": {
      "optional": true
    },
    "@azure/service-bus": {
      "optional": true
    },
    "@google-cloud/pubsub": {
      "optional": true
    },
    "oci-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || >=26.0.0"
  }
}
