{
  "name": "@agnostic-cloud/secrets",
  "version": "0.0.0",
  "description": "Unified secrets management interface for AWS Secrets Manager, GCP Secret Manager, and Azure Key Vault",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@aws-sdk/client-secrets-manager": "^3.500.0",
    "@google-cloud/secret-manager": "^5.0.0",
    "@azure/keyvault-secrets": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-secrets-manager": { "optional": true },
    "@google-cloud/secret-manager": { "optional": true },
    "@azure/keyvault-secrets": { "optional": true }
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || >=26.0.0"
  }
}
