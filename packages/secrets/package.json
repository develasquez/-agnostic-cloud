{
  "name": "@agnostic-cloud/secrets",
  "version": "0.1.2",
  "description": "Unified secrets management interface for AWS Secrets Manager, GCP Secret Manager, and Azure Key Vault",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1095.0",
    "@azure/identity": "^4.13.1",
    "@azure/keyvault-secrets": "^4.11.2",
    "@google-cloud/secret-manager": "^5.6.0",
    "oci-sdk": "^2.137.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-secrets-manager": {
      "optional": true
    },
    "@azure/identity": {
      "optional": true
    },
    "@azure/keyvault-secrets": {
      "optional": true
    },
    "@google-cloud/secret-manager": {
      "optional": true
    },
    "oci-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || >=26.0.0"
  }
}
