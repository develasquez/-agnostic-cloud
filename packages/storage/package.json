{
  "name": "@agnostic-cloud/storage",
  "version": "0.0.0",
  "description": "Unified object storage interface for S3, GCS, and Azure Blob Storage",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.500.0",
    "@google-cloud/storage": "^7.0.0",
    "@azure/storage-blob": "^12.0.0",
    "@azure/identity": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": { "optional": true },
    "@google-cloud/storage": { "optional": true },
    "@azure/storage-blob": { "optional": true },
    "@azure/identity": { "optional": true }
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
